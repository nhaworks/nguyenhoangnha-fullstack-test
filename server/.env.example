# Cổng chạy server
PORT=3000

# Kết nối MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=template_library

# Database riêng cho npm test, để test không đụng dữ liệu thật
TEST_DB_NAME=template_library_test

# Chưa có đăng nhập: mọi tài liệu lưu ở storage/documents/<DEFAULT_USER_ID>/
DEFAULT_USER_ID=demo

# Thư mục lưu file. Để trống = dùng server/storage
STORAGE_ROOT=
